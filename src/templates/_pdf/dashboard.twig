{% extends 'insights/_pdf/_layout.twig' %}

{% macro section(label, columns, rows) %}
    <h2>{{ label|t('insights') }}</h2>
    {% if rows|length %}
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        {% for col in columns %}
                            <th{% if col.numeric ?? false %} class="number"{% endif %}>{{ col.label|t('insights') }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            {% for col in columns %}
                                {% set raw = row[col.key] ?? null %}
                                {% set isUrl = col.key == 'url' or col.key == 'targetDomain' or col.key == 'searchTerm' or col.key == 'eventName' %}
                                {% set value = raw is null or raw == '' ? '-' : (col.numeric ?? false ? raw|number_format : raw) %}
                                <td class="{{ col.numeric ?? false ? 'number' : (isUrl ? 'url' : '') }}">{{ value }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="empty">{{ 'No data available for this period.'|t('insights') }}</div>
    {% endif %}
{% endmacro %}

{% block content %}
    {% set avgMinutes = (summary.avgTimeOnPage / 60)|round(0, 'floor') %}
    {% set avgSeconds = summary.avgTimeOnPage % 60 %}

    <h2>{{ 'Summary'|t('insights') }}</h2>
    <table class="kpi-grid kpi-grid-summary">
        <tr>
            <td class="kpi-cell first">
                <div class="kpi-card">
                    <div class="kpi-label">{{ 'Pageviews'|t('insights') }}</div>
                    <div class="kpi-value">{{ summary.pageviews|number_format }}</div>
                    <div class="kpi-trend {{ summary.pageviewsTrend >= 0 ? 'positive' : 'negative' }}">
                        {{ summary.pageviewsTrend >= 0 ? '▲' : '▼' }} {{ summary.pageviewsTrend|abs }}% {{ 'vs previous'|t('insights') }}
                    </div>
                </div>
            </td>
            <td class="kpi-cell">
                <div class="kpi-card">
                    <div class="kpi-label">{{ 'Unique Visitors'|t('insights') }}</div>
                    <div class="kpi-value">{{ summary.uniqueVisitors|number_format }}</div>
                    <div class="kpi-trend {{ summary.visitorsTrend >= 0 ? 'positive' : 'negative' }}">
                        {{ summary.visitorsTrend >= 0 ? '▲' : '▼' }} {{ summary.visitorsTrend|abs }}% {{ 'vs previous'|t('insights') }}
                    </div>
                </div>
            </td>
            <td class="kpi-cell">
                <div class="kpi-card">
                    <div class="kpi-label">{{ 'Avg. Time / Page'|t('insights') }}</div>
                    <div class="kpi-value">{{ avgMinutes }}m {{ avgSeconds }}s</div>
                    <div class="kpi-trend">{{ 'Average per pageview'|t('insights') }}</div>
                </div>
            </td>
            <td class="kpi-cell last">
                <div class="kpi-card">
                    <div class="kpi-label">{{ 'Bounce Rate'|t('insights') }}</div>
                    <div class="kpi-value">{{ summary.bounceRate }}%</div>
                    <div class="kpi-trend">{{ 'Single page visits'|t('insights') }}</div>
                </div>
            </td>
        </tr>
    </table>

    {% if chartSvg %}
        <div class="chart-card">
            <div class="chart-legend">
                <span class="chart-legend-item"><span class="chart-swatch" style="background:#3B82F6"></span> {{ 'Pageviews'|t('insights') }}</span>
                <span class="chart-legend-item"><span class="chart-swatch" style="background:#10B981"></span> {{ 'Unique Visitors'|t('insights') }}</span>
            </div>
            {{ chartSvg|raw }}
        </div>
    {% endif %}

    {{ _self.section('Top Pages', [
        { key: 'url', label: 'Page' },
        { key: 'views', label: 'Views', numeric: true },
        { key: 'uniqueVisitors', label: 'Visitors', numeric: true },
    ], topPages) }}

    {{ _self.section('Traffic Sources', [
        { key: 'referrerDomain', label: 'Source' },
        { key: 'referrerType', label: 'Type' },
        { key: 'visits', label: 'Visits', numeric: true },
    ], topReferrers) }}

    {{ _self.section('Devices', [
        { key: 'deviceType', label: 'Device' },
        { key: 'visits', label: 'Visits', numeric: true },
    ], devices) }}

    {{ _self.section('Browsers', [
        { key: 'browserFamily', label: 'Browser' },
        { key: 'visits', label: 'Visits', numeric: true },
    ], browsers) }}

    {% if isPro %}
        {{ _self.section('Top Countries', [
            { key: 'countryCode', label: 'Country' },
            { key: 'visits', label: 'Visits', numeric: true },
        ], topCountries) }}

        {{ _self.section('Campaigns', [
            { key: 'utmSource', label: 'Source' },
            { key: 'utmMedium', label: 'Medium' },
            { key: 'utmCampaign', label: 'Campaign' },
            { key: 'visits', label: 'Visits', numeric: true },
        ], topCampaigns) }}

        {{ _self.section('Top Events', [
            { key: 'eventName', label: 'Event' },
            { key: 'eventCategory', label: 'Category' },
            { key: 'count', label: 'Count', numeric: true },
            { key: 'uniqueVisitors', label: 'Visitors', numeric: true },
        ], topEvents) }}

        {{ _self.section('Outbound Links', [
            { key: 'targetDomain', label: 'Domain' },
            { key: 'clicks', label: 'Clicks', numeric: true },
            { key: 'uniqueVisitors', label: 'Visitors', numeric: true },
        ], topOutboundLinks) }}

        {{ _self.section('Site Searches', [
            { key: 'searchTerm', label: 'Search Term' },
            { key: 'searches', label: 'Searches', numeric: true },
            { key: 'uniqueVisitors', label: 'Visitors', numeric: true },
        ], topSearches) }}

        {{ _self.section('Entry Pages', [
            { key: 'url', label: 'Page' },
            { key: 'sessions', label: 'Sessions', numeric: true },
        ], topEntryPages) }}

        {{ _self.section('Exit Pages', [
            { key: 'url', label: 'Page' },
            { key: 'sessions', label: 'Sessions', numeric: true },
        ], topExitPages) }}

        {{ _self.section('Scroll Depth', [
            { key: 'url', label: 'Page' },
            { key: 'milestone25', label: '25%', numeric: true },
            { key: 'milestone50', label: '50%', numeric: true },
            { key: 'milestone75', label: '75%', numeric: true },
            { key: 'milestone100', label: '100%', numeric: true },
        ], scrollDepth) }}
    {% endif %}
{% endblock %}
