{# @var frequency \samuelreichor\insights\enums\EmailFrequency #}
{# @var summary array #}
{# @var topPages array #}
{# @var topReferrers array #}
{# @var periodDays int #}
{# @var dashboardUrl string #}

{% set bodyStyle = 'font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #1f2937; line-height: 1.5; max-width: 560px; margin: 0 auto; padding: 24px; font-size: 14px;' %}
{% set headingStyle = 'margin: 20px 0 6px; font-size: 14px; color: #111827; font-weight: 600;' %}
{% set tableStyle = 'width: 100%; border-collapse: collapse; font-size: 13px;' %}
{% set cellStyle = 'padding: 6px 0; border-bottom: 1px solid #f3f4f6;' %}
{% set cellRightStyle = cellStyle ~ ' text-align: right; font-variant-numeric: tabular-nums;' %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ 'Insights Report'|t('insights') }}</title>
</head>
<body style="{{ bodyStyle }}">

<h1 style="font-size: 18px; margin: 0 0 2px;">{{ 'Insights Analytics Report'|t('insights') }}</h1>
<p style="color: #6b7280; margin: 0 0 20px; font-size: 13px;">
    {{ 'Last {n} days'|t('insights', { n: periodDays }) }}
</p>

{# ===== Summary ===== #}
<table style="{{ tableStyle }}">
    <tr>
        <td style="{{ cellStyle }}">{{ 'Pageviews'|t('insights') }}</td>
        <td style="{{ cellRightStyle }}"><strong>{{ summary.pageviews|number_format }}</strong></td>
    </tr>
    <tr>
        <td style="{{ cellStyle }}">{{ 'Unique Visitors'|t('insights') }}</td>
        <td style="{{ cellRightStyle }}"><strong>{{ summary.uniqueVisitors|number_format }}</strong></td>
    </tr>
    <tr>
        <td style="{{ cellStyle }} border-bottom: none;">{{ 'Bounce Rate'|t('insights') }}</td>
        <td style="{{ cellRightStyle }} border-bottom: none;"><strong>{{ summary.bounceRate }}%</strong></td>
    </tr>
</table>

{# ===== Top Pages ===== #}
<h2 style="{{ headingStyle }}">{{ 'Top Pages'|t('insights') }}</h2>
{% if topPages is empty %}
    <p style="color: #6b7280; font-size: 13px; margin: 0;">{{ 'No data yet.'|t('insights') }}</p>
{% else %}
<table style="{{ tableStyle }}">
    {% for page in topPages %}
    <tr>
        <td style="{{ cellStyle }}">{{ page.url }}</td>
        <td style="{{ cellRightStyle }} width: 80px;">{{ page.views|number_format }}</td>
    </tr>
    {% endfor %}
</table>
{% endif %}

{# ===== Top Traffic Sources ===== #}
<h2 style="{{ headingStyle }}">{{ 'Top Traffic Sources'|t('insights') }}</h2>
{% if topReferrers is empty %}
    <p style="color: #6b7280; font-size: 13px; margin: 0;">{{ 'No data yet.'|t('insights') }}</p>
{% else %}
<table style="{{ tableStyle }}">
    {% for ref in topReferrers %}
    <tr>
        <td style="{{ cellStyle }}">{{ ref.referrerDomain ?: ('Direct'|t('insights')) }}</td>
        <td style="{{ cellRightStyle }} width: 80px;">{{ ref.visits|number_format }}</td>
    </tr>
    {% endfor %}
</table>
{% endif %}

{# ===== LLM Bot Activity (only when LLMify is installed) ===== #}
{% if llmTotals is not null %}
    <h2 style="{{ headingStyle }}">{{ 'LLM Bot Activity'|t('insights') }}</h2>
    <table style="{{ tableStyle }}">
        <tr>
            <td style="{{ cellStyle }}">{{ 'Total Visits'|t('insights') }}</td>
            <td style="{{ cellRightStyle }}">
                <strong>{{ llmTotals.totalRequests|number_format }}</strong> {{ 'Bots'|t('insights') }} ·
                <strong>{{ llmTotals.humanRequests|number_format }}</strong> {{ 'Humans'|t('insights') }}
            </td>
        </tr>
        <tr>
            <td style="{{ cellStyle }}">{{ 'Unique Bots'|t('insights') }}</td>
            <td style="{{ cellRightStyle }}"><strong>{{ llmTotals.uniqueBots|number_format }}</strong></td>
        </tr>
        <tr>
            <td style="{{ cellStyle }}">{{ 'Top Crawler'|t('insights') }}</td>
            <td style="{{ cellRightStyle }}">
                <strong>{{ llmTotals.topBot ?? '—' }}</strong>
                {% if llmTotals.topBot %}<span style="color: #6b7280;">({{ llmTotals.topBotShare }}%)</span>{% endif %}
            </td>
        </tr>
        <tr>
            <td style="{{ cellStyle }} border-bottom: none;">{{ 'Delivery Split'|t('insights') }}</td>
            <td style="{{ cellRightStyle }} border-bottom: none;">
                <strong>{{ llmTotals.directShare }}%</strong> {{ 'Direct'|t('insights') }} ·
                <strong>{{ llmTotals.negotiatedShare }}%</strong> {{ 'Negotiated'|t('insights') }}
            </td>
        </tr>
    </table>

    {% if llmTopPages is not empty %}
        <h2 style="{{ headingStyle }}">{{ 'Top Visited Markdowns'|t('insights') }}</h2>
        <table style="{{ tableStyle }}">
            {% for page in llmTopPages %}
            <tr>
                <td style="{{ cellStyle }}">{{ page.url }}</td>
                <td style="{{ cellRightStyle }} width: 80px;">{{ page.totalCrawls|number_format }}</td>
            </tr>
            {% endfor %}
        </table>
    {% endif %}
{% endif %}

{# ===== CTA ===== #}
<p style="margin: 28px 0 8px;">
    <a href="{{ dashboardUrl }}"
       style="display: inline-block; padding: 10px 18px; background: #111827; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 500;">
        {{ 'See all Insights'|t('insights') }}
    </a>
</p>

<p style="color: #9ca3af; font-size: 11px; margin-top: 24px; border-top: 1px solid #e5e7eb; padding-top: 12px;">
    <a href="https://samuelreichor.at/libraries/craft-insights" style="color: #6b7280; text-decoration: none;">Insights</a>
    — {{ 'DSGVO-compliant analytics for Craft CMS.'|t('insights') }}
</p>

</body>
</html>
