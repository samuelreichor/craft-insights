{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% set title = 'Site Searches'|t('insights') %}
{% set selectedSubnavItem = 'searches' %}

{# Site Selection via Breadcrumbs #}
{% set selectableSites = craft.app.sites.getEditableSites() %}
{% set selectedSite = craft.app.sites.getSiteById(selectedSiteId) %}

{% set crumbs = [] %}
{% if craft.app.getIsMultiSite() %}
    {% set crumbs = crumbs|merge([{
        id: 'site-crumb',
        icon: 'world',
        label: selectedSite.name|t('site'),
        menu: {
            items: siteMenuItems(selectableSites, selectedSite),
            label: 'Select site'|t('app')
        },
    }]) %}
{% endif %}
{% set crumbs = crumbs|merge([
    { label: 'Insights'|t('insights'), url: cpUrl('insights') },
]) %}

{% block content %}
<div class="insights-page">
    <div class="flex" style="margin-bottom: 24px; gap: 12px; align-items: center;">
        <div>
            {{ forms.selectField({
                id: 'range-select',
                name: 'range',
                options: [
                    { label: 'Today'|t('insights'), value: 'today' },
                    { label: 'Last 7 Days'|t('insights'), value: '7d' },
                    { label: 'Last 30 Days'|t('insights'), value: '30d' },
                    { label: 'Last 90 Days'|t('insights'), value: '90d' },
                    { label: 'Last 12 Months'|t('insights'), value: '12m' },
                ],
                value: selectedRange,
            }) }}
        </div>
        <div class="flex-grow"></div>
        {% if currentUser.can('insights:exportData') %}
        {% include '_includes/disclosuremenu.twig' with {
            withButton: true,
            buttonLabel: 'Export'|t('insights'),
            items: [
                { label: 'Export CSV'|t('insights'), url: actionUrl('insights/export/searches', { siteId: selectedSiteId, range: selectedRange, format: 'csv' }), attributes: { id: 'export-csv-link' } },
                { label: 'Export PDF'|t('insights'), url: actionUrl('insights/export/searches', { siteId: selectedSiteId, range: selectedRange, format: 'pdf' }), attributes: { id: 'export-pdf-link' } },
            ],
        } only %}
        {% endif %}
    </div>

    <div id="searches-table"></div>
</div>

{% js %}
(function() {
    var siteId = {{ selectedSiteId }};
    var range = '{{ selectedRange }}';

    function getTableEndpoint() {
        return Craft.getActionUrl('insights/dashboard/searches-table-data', {
            siteId: siteId,
            range: range
        });
    }

    var adminTable = new Craft.VueAdminTable({
        columns: [
            { name: 'searchTerm', title: Craft.t('insights', 'Search Term'), sortField: 'searchTerm' },
            { name: 'resultsCount', title: Craft.t('insights', 'Results'), sortField: 'resultsCount' },
            { name: 'searches', title: Craft.t('insights', 'Searches'), sortField: 'searches' },
            { name: 'uniqueVisitors', title: Craft.t('insights', 'Unique Visitors'), sortField: 'uniqueVisitors' }
        ],
        container: '#searches-table',
        tableDataEndpoint: getTableEndpoint(),
        search: true,
        searchPlaceholder: Craft.t('insights', 'Search terms...'),
        emptyMessage: Craft.t('insights', 'No search data yet'),
        perPage: 50,
        padded: true
    });

    // Handle range filter change
    var rangeSelect = document.getElementById('range-select');

    function updateTable() {
        range = rangeSelect.value;

        // Update export links
        ['csv', 'pdf'].forEach(function(format) {
            var link = document.getElementById('export-' + format + '-link');
            if (link) {
                link.href = Craft.getActionUrl('insights/export/searches', {
                    siteId: siteId,
                    range: range,
                    format: format
                });
            }
        });

        // Update table endpoint and reload
        adminTable.settings.tableDataEndpoint = getTableEndpoint();
        adminTable.reload();
    }

    rangeSelect.addEventListener('change', updateTable);
})();
{% endjs %}
{% endblock %}
